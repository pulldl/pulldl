{
  "manifest_version": 3,
  "name": "PullDL — Universal Media Sniffer & Turbo Manager",
  "version": "3.0.0",
  "description": "7-Layer Universal Media Sniffer, Adaptive Multi-Thread Turbo Downloader, and JDownloader-style Batch LinkGrabber for all websites.",
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "webRequest",
    "contextMenus",
    "tabs",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "https://pulldl.com/*",
      "https://*.pulldl.com/*",
      "http://localhost/*",
      "http://localhost:*/*"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PullDL Universal Studio",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page_bridge.js",
        "assets/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
